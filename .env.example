# Public Firebase web configuration, not administrator credentials.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# SERVER ONLY: set FIREBASE_SERVICE_ACCOUNT_KEY in the deployment secret manager.
# Never prefix administrator or AI credentials with VITE_.
# Optional self-hosted Ollama marker. Leave disabled until teacher-marked
# benchmark answers have been reviewed and the model host is secured.
MARKER_AI_ENABLED=false
MARKER_PROVIDER=ollama
MARKER_OLLAMA_URL=
MARKER_OLLAMA_MODEL=
MARKER_OLLAMA_TOKEN=
# Alternative: Cloudflare Workers AI. Keep disabled until terms, privacy and
# teacher-marked benchmark have been checked. All values are server-only.
CLOUDFLARE_ACCOUNT_ID=39046456f5da1bf1758f8f85cb008f7f
CLOUDFLARE_AI_TOKEN=
CLOUDFLARE_AI_MODEL=
