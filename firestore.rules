rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // 1. Questions Collection
    match /questions/{questionId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update, delete: if false;
    }

    // 2. User Progress Collection (Spaced Repetition Data)
    match /user_progress/{progressId} {
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update: if request.auth != null 
                    && resource.data.userId == request.auth.uid 
                    && request.resource.data.userId == request.auth.uid;
      allow delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }

    // 3. Link Codes Collection for secure parent-student linking
    match /link_codes/{code} {
      // Anyone can read a link code to get the studentId, if they know the code
      allow read: if request.auth != null;
      // Only the student can create their own link code
      allow create: if request.auth != null && request.resource.data.studentId == request.auth.uid;
      // Only the student can delete their own link code
      allow delete: if request.auth != null && resource.data.studentId == request.auth.uid;
      allow update: if false;
    }

    // 4. Users Collection (Profiles, linking, roles)
    match /users/{userId} {
      // Users can read/write their own profile
      allow read, write: if request.auth != null && request.auth.uid == userId;
      // Parents can read a student's profile if the student is in their linkedStudents array
      allow read: if request.auth != null && 
                  (userId in get(/databases/$(database)/documents/users/$(request.auth.uid)).data.linkedStudents);
      
      // 5. Sessions Subcollection (Practice history)
      match /sessions/{sessionId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
        // Linked parents can read sessions
        allow read: if request.auth != null && 
                    (userId in get(/databases/$(database)/documents/users/$(request.auth.uid)).data.linkedStudents);
      }

      // 6. Progress Subcollection
      match /progress/{progressId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
        allow read: if request.auth != null && 
                    (userId in get(/databases/$(database)/documents/users/$(request.auth.uid)).data.linkedStudents);
      }
    }
  }
}
